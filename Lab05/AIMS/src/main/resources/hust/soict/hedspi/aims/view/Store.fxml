<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane prefHeight="800" prefWidth="1024" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="hust.soict.hedspi.aims.controller.StoreController">

    <top>
        <HBox spacing="10">
            <padding>
                <Insets bottom="0" left="20" right="20" top="0" />
            </padding>
            <children>
                <Label style="-fx-font-size:50px; -fx-text-fill:#004cff;" text="AIMS" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="viewCartButton" prefHeight="50" prefWidth="100" text="View Cart" />
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" prefHeight="695.0" prefWidth="1024">
            <content>
                <GridPane fx:id="gridPane" hgap="10" prefHeight="0" prefWidth="0" vgap="10" />
            </content>
        </ScrollPane>
    </center>

</BorderPane>
